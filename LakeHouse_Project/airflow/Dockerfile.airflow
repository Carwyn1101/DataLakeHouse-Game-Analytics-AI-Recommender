FROM apache/airflow:3.0.6-python3.11

USER root

# Cài Java 17
RUN apt-get update && \
    apt-get install -y openjdk-17-jdk-headless && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Download Hadoop AWS JARs 
RUN mkdir -p /opt/airflow/jars && \
    cd /opt/airflow/jars && \
    curl -O https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.2/hadoop-aws-3.3.2.jar && \
    curl -O https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.11.1026/aws-java-sdk-bundle-1.11.1026.jar && \
    curl -O https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-3.3_2.12/1.3.1/iceberg-spark-runtime-3.3_2.12-1.3.1.jar && \
    chown -R airflow:root /opt/airflow/jars

USER airflow

# Cài PySpark 3.3.2 (KHỚP với Spark cluster)
RUN pip install --no-cache-dir \
    pyspark==3.3.2 \
    pandas==1.5.3 \
    numpy==1.24.3 \
    pyarrow==12.0.1

# # Set SPARK environment 
# ENV SPARK_HOME=/home/airflow/.local/lib/python3.11/site-packages/pyspark
# ENV PYSPARK_SUBMIT_ARGS="--jars /opt/airflow/jars/hadoop-aws-3.3.2.jar,/opt/airflow/jars/aws-java-sdk-bundle-1.11.1026.jar,/opt/airflow/jars/iceberg-spark-runtime-3.3_2.12-1.3.1.jar pyspark-shell"
